<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking History - Pet Care</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5">
    <h1 class="mb-4">Booking History</h1>

    <% if (messages.length > 0) { %>
      <% messages.forEach((message) => { %>
        <div class="alert alert-success" role="alert"><%= message %></div>
      <% }); %>
    <% } %>
    <% if (errors.length > 0) { %>
      <% errors.forEach((error) => { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% }); %>
    <% } %>

    <p><a href="/services" class="btn btn-primary">Book a Service</a></p>

    <% if (bookings.length === 0) { %>
      <p class="alert alert-info" role="status">You have no bookings yet.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th>Booking ID</th>
              <th>Date</th>
              <th>Pet</th>
              <th>Service</th>
              <th>Booked Price</th>
              <th>Booking Status</th>
              <th>Payment Status</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach((booking) => { %>
              <tr>
                <td><%= booking.booking_id %></td>
                <td><%= booking.booking_date %></td>
                <td><%= booking.pet_name %></td>
                <td><%= booking.service_name %></td>
                <td>S$<%= Number(booking.booked_price).toFixed(2) %></td>
                <td><%= booking.booking_status %></td>
                <td><%= booking.payment_status || 'No payment record' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
